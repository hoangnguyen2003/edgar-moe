{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["sin1"],
  "functions": {"index.py": {"maxDuration": 20}},
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "Cache-Control", "value": "private, no-store"},
    {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}
  ]}]
}
