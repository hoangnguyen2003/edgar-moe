# Identify automated SEC requests. The SEC requires a descriptive user agent.
SEC_USER_AGENT="EDGAR-MoE Research your-email@example.com"

# Free account credentials. Never commit real values.
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
FRED_API_KEY=""

# Runtime configuration
EDGAR_MOE_DATA_DIR="data"
EDGAR_MOE_DEMO_SNAPSHOT="data/demo/snapshot.json"
EDGAR_MOE_LOG_LEVEL="INFO"

# Forward-testing registry. Leave empty in a stateless public deployment, or use
# sqlite:///data/forward/registry.sqlite3 locally and a Neon Postgres URL in production.
EDGAR_MOE_REGISTRY_DATABASE_URL=""

# Content-addressed model/run artifacts. Local storage works without an account.
# Set the backend to r2 and provide the remaining values for Cloudflare R2.
EDGAR_MOE_ARTIFACT_BACKEND="local"
EDGAR_MOE_ARTIFACT_DIR="data/forward/artifacts"
EDGAR_MOE_R2_ENDPOINT_URL=""
EDGAR_MOE_R2_BUCKET=""
EDGAR_MOE_R2_ACCESS_KEY_ID=""
EDGAR_MOE_R2_SECRET_ACCESS_KEY=""
