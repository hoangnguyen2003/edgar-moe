# Identify automated SEC requests. The SEC requires a descriptive user agent.
SEC_USER_AGENT="EDGAR-MoE Research your-email@example.com"

# Free account credentials. Never commit real values.
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
FRED_API_KEY=""

# Runtime configuration
EDGAR_MOE_DATA_DIR="data"
EDGAR_MOE_DEMO_SNAPSHOT="data/demo/snapshot.json"
EDGAR_MOE_LOG_LEVEL="INFO"

# Forward-testing writer registry. The private runner and migration commands use
# this URL. Leave empty in a stateless public deployment, or use
# sqlite:///data/forward/registry.sqlite3 locally.
EDGAR_MOE_REGISTRY_DATABASE_URL=""
# API reader URL. In hosted Postgres, use a separate SELECT-only role and set
# this only in the API host (for example Vercel). Leave empty only for a
# stateless API or local SQLite development.
EDGAR_MOE_REGISTRY_READ_DATABASE_URL=""
# API Postgres sessions default to read-only transactions and a five-second
# database-side statement timeout; the timeout is ignored for local SQLite.
EDGAR_MOE_REGISTRY_API_STATEMENT_TIMEOUT_MS=5000

# Content-addressed model/run artifacts. Local storage works without an account.
# Set the backend to r2 and provide the remaining values for Cloudflare R2.
EDGAR_MOE_ARTIFACT_BACKEND="local"
# Keep the append-only registry's existing local:// identities while copying the
# same content-addressed objects to durable R2 storage.
EDGAR_MOE_ARTIFACT_MIRROR_BACKEND="none"
EDGAR_MOE_ARTIFACT_DIR="data/forward/artifacts"
EDGAR_MOE_R2_ENDPOINT_URL=""
EDGAR_MOE_R2_BUCKET=""
EDGAR_MOE_R2_ACCESS_KEY_ID=""
EDGAR_MOE_R2_SECRET_ACCESS_KEY=""

# Optional GitHub Actions-only HTTPS webhook for redacted forward alerts.
# Prefer configuring this as the EDGAR_MOE_ALERT_WEBHOOK_URL repository secret.
EDGAR_MOE_ALERT_WEBHOOK_URL=""

# Optional operator-run, read-only research copilot. Keep this out of Vercel
# and never commit a real key. The endpoint must be HTTPS, or loopback HTTP for
# a local OpenAI-compatible runtime such as Ollama.
EDGAR_MOE_COPILOT_API_KEY=""
EDGAR_MOE_COPILOT_ENDPOINT="https://api.openai.com/v1/chat/completions"
EDGAR_MOE_COPILOT_MODEL="gpt-4o-mini"
EDGAR_MOE_COPILOT_TIMEOUT_SECONDS="30"
EDGAR_MOE_COPILOT_MAX_TOKENS="800"
EDGAR_MOE_COPILOT_MAX_TOOL_CALLS="4"
