{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix apps/web ci && npm --prefix apps/web run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/index.py" },
    { "source": "/api/docs", "destination": "/api/index.py" },
    { "source": "/api/openapi.json", "destination": "/api/index.py" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
