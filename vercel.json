{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "fluid": true,
  "buildCommand": "npm --prefix apps/web ci && npm --prefix apps/web run build -- --outDir ../../public --emptyOutDir",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{data/demo/snapshot.json,src/edgar_moe/**}",
      "excludeFiles": "{.venv/**,.github/**,apps/**,config/**,docs/**,notebooks/**,reports/**,scripts/**,tests/**,dist/**,**/__pycache__/**,.mypy_cache/**,.pytest_cache/**,.ruff_cache/**}"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
